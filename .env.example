# --- Sovos ---------------------------------------------------------------
SOVOS_BASE_URL=https://api-test.sovos.com
# Autenticación: oauth2 (client credentials) o static (token fijo entregado por Sovos)
SOVOS_AUTH_MODE=oauth2
SOVOS_TOKEN_URL=
SOVOS_CLIENT_ID=
SOVOS_CLIENT_SECRET=
SOVOS_SCOPE=
# Solo si SOVOS_AUTH_MODE=static
SOVOS_STATIC_TOKEN=
SOVOS_SENDER_SYSTEM_ID=DefaultSystemERP
SOVOS_POLLING_SYSTEM_ID=CN_SystemERP_Polling
# Consulta de estado: document (por documentId) o global (lista de notificaciones)
SOVOS_STATUS_MODE=document
# Raíz UBL de notas dentro del SCI: CreditNote (UBL nativo) o Invoice. Confirmar con Sovos.
SOVOS_NOTE_ROOT=CreditNote
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=5

# --- Emisor --------------------------------------------------------------
EMISOR_RUC=20437310841
# Forma de pago para facturas mientras no se confirme el campo del TXT
FORMA_PAGO_DEFECTO=Contado

# --- Carpetas ------------------------------------------------------------
# Carpeta donde el sistema Java deja los TXT
INBOX_DIR=C:\facturacion\salida_txt
# Carpeta de trabajo (processing, processed, error, duplicates, output, logs, db)
WORK_DIR=C:\sovos_bridge

# --- Tiempos -------------------------------------------------------------
POLL_SECONDS=10
STATUS_POLL_SECONDS=30
MAX_STATUS_MINUTES=60
# Segundos que el tamaño del archivo debe mantenerse igual antes de tomarlo
FILE_STABLE_SECONDS=3

# --- Otros ---------------------------------------------------------------
# true = genera el SBD en WORK_DIR/dry_run sin enviarlo
DRY_RUN=false
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
